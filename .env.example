# Copy to .env for `make run`; values below match the MySQL and Redis of `docker compose up mysql redis`.
# Variables left commented out use the default shown. Real environment variables win over .env.

# HTTP server
# SERVER_PORT=8080
# SERVER_READ_HEADER_TIMEOUT=5s
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=15s
# SERVER_IDLE_TIMEOUT=60s
# SERVER_SHUTDOWN_TIMEOUT=10s
# Take client addresses from X-Forwarded-For / X-Real-IP. Enable only behind a proxy that overwrites them.
# TRUST_PROXY_HEADERS=false

# Logging: debug | info | warn | error; json | text
LOG_LEVEL=debug
LOG_FORMAT=text

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=apppassword
DB_NAME=team_task_nexus
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=5m
# DB_CONNECT_TIMEOUT=30s

# Redis
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Authentication. JWT_SECRET is required and must be at least 32 bytes.
JWT_SECRET=local-development-secret-change-me-0123456789
# JWT_ISSUER=team-task-nexus
# JWT_TTL=24h
# BCRYPT_COST=10

# Rate limits per minute: per user on the API, per client address on register and login
# RATE_LIMIT_API_PER_MINUTE=100
# RATE_LIMIT_AUTH_PER_MINUTE=10

# Task list cache
# CACHE_TASK_LIST_TTL=5m

# Outbox dispatcher. OUTBOX_LEASE must exceed NOTIFY_WEBHOOK_TIMEOUT.
# OUTBOX_POLL_INTERVAL=1s
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_LEASE=30s

# Notifications are logged unless a webhook is set
# NOTIFY_WEBHOOK_URL=https://example.com/hooks/team-task-nexus
# NOTIFY_WEBHOOK_TIMEOUT=5s
